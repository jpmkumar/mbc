# Data (large files — use download scripts)
data/raw/
data/processed/
data/splits/*.csv
data/splits/histopath/train.csv
data/splits/histopath/test.csv
data/splits/histopath/folds/**/*.csv
data/splits/histopath/runtime/
data/splits/histopath_kaggle/train.csv
data/splits/histopath_kaggle/test.csv
data/splits/histopath_kaggle/folds/**/*.csv
data/splits/histopath_kaggle/runtime/
# Patient-level fold membership is the released reproducibility artifact: it is
# tiny, and StratifiedGroupKFold assignments are not stable across scikit-learn
# versions, so folds must be loaded rather than regenerated.
!data/splits/histopath/folds/**/*_patients.csv
!data/splits/histopath_kaggle/folds/**/*_patients.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Checkpoints and logs
results/
colab_results/results/
*.pt
*.pth
runs/
*.log

# OS / IDE
.DS_Store
~$*
.cursor/

# ---------------------------------------------------------------------------
# This repository is a code release. Manuscript sources, bibliography, figure
# artwork, submission paperwork, and editorial working notes are maintained
# separately and are not tracked here.
#
# Deliberate exception: preregistration/ stays tracked. The data availability
# statement points reviewers at this repository's commit history to confirm the
# order in which protocols were declared, so those files and their commit dates
# must remain public.
# ---------------------------------------------------------------------------
paper/
publication/
papers/*/manuscript/
papers/*/manuscript_frontiers/
papers/*/survey/
# Figure artwork is manuscript material. It is regenerated by
# experiments/generate_figures.py and papers/paper_b/scripts/plot_paper_figures.py,
# so nothing is lost by keeping it out of the release.
figures/
initial_paper_architecture.png
**/*.tex
**/*.bib
**/*.docx
**/*.tikz
**/*.cls
**/*.bst
papers/*/SUBMISSION_CHECKLIST.md
papers/*/FREEZE_CHECKLIST.md
papers/*/MANIFEST.md
papers/*/VENUE.md
**/PAPER_WRITING_*.md
**/GAP_STATEMENT.md
**/GAP_ANALYSIS.md
**/FIGURE_CAPTIONS.md
**/AUTHORS.md
scripts/generate_publication.py
scripts/sync_publication_metrics.py
experiments/update_manuscript_results.py
# Per-paper authoring conventions and editorial working notes.
**/AGENTS.md
**/SKILL.md
papers/HOW_TO_USE_AGENTS.md
# Tooling that assembles or checks the submission package rather than producing
# a result. The figure scripts are deliberately not listed: they generate
# reported artefacts and belong in the release.
papers/*/scripts/build_frontiers_package.sh
papers/*/scripts/build_submission_package.sh
papers/*/scripts/export_figures_tiff.py
papers/*/scripts/check_text_overlap.py
papers/*/scripts/verify_references.py

# Local drafts and working documents
InitialPaperInfo.docx
HISTOPATH_QML_REPORT.md
paper/manuscript.docx
paper/manuscript_neutral.md
paper/manuscript_reference.docx
scripts/generate_manuscript_docx.py
**/agent-transcripts/
**/*_QML_REPORT*.md
**/*viva*.md
GPU_PROJECT_PLAN.md
**/*PROJECT_PLAN*.md

# Paper workspaces — curated local exports only
papers/paper_a/results/
papers/paper_a/assets/
papers/paper_a/**/*.docx
papers/paper_a/**/*.pdf
papers/paper_b/results/
# Released with the code so the Data Availability Statement is accurate: the
# curated snapshot is the experiment summary the reported tables and figures are
# generated from. Everything else in the directory stays local.
!papers/paper_b/results/
papers/paper_b/results/*
!papers/paper_b/results/curated_metrics.json
!papers/paper_b/results/export_log.txt
!papers/paper_b/results/README.md
papers/paper_b/assets/
papers/paper_b/submission/
papers/paper_b/**/*.docx
papers/paper_b/**/*.pdf
papers/paper_b/**/*.png
papers/paper_b/manuscript/*.aux
papers/paper_b/manuscript/*.bbl
papers/paper_b/manuscript/*.blg
papers/paper_b/manuscript/*.log
papers/paper_b/manuscript/*.out
papers/paper_b/manuscript/*.synctex.gz
!papers/paper_b/figures/export/*.pdf
papers/paper_c/results/
!papers/paper_c/results/
papers/paper_c/results/*
!papers/paper_c/results/phase0_patient_grouping.md
!papers/paper_c/results/idc_context_audit.md
!papers/paper_c/results/pipeline_qualification.md
!papers/paper_c/results/precision_simulation.md
papers/paper_c/assets/
papers/paper_c/scripts/crossref_verified.bib
papers/paper_c/**/*.docx
papers/paper_c/manuscript/*.aux
papers/paper_c/manuscript/*.bbl
papers/paper_c/manuscript/*.blg
papers/paper_c/manuscript/*.log
papers/paper_c/manuscript/*.out
papers/paper_c/manuscript/*.synctex.gz

